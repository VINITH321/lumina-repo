# ─── PostgreSQL Database Configuration (Active) ─────────────────────────────
# Cloud (e.g. Neon, Supabase, Render):
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Or Local:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina_ecom

# ─── MongoDB (Commented Out) ────────────────────────────────────────────────
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lumina_ecom?retryWrites=true&w=majority

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
JWT_SECRET=lumina_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
